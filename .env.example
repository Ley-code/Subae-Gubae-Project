# --- Database ---
# Local Docker Postgres (default for local dev — run `docker compose up -d` first):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meserete_dev"
# Neon (cloud/staging) — copy the connection string from your Neon dashboard instead, e.g.:
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/meserete?sslmode=require"

# --- Auth.js (NextAuth v5) ---
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# --- Cloudinary (admin file uploads: gallery photos, educational materials, post-launch) ---
# Copy the "API Environment variable" string from your Cloudinary dashboard:
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
